FROM python:3.12-slim AS builder
ARG INSTALL_RERANK=false
WORKDIR /build
COPY backend/requirements.txt backend/requirements-rerank.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt --target /build/packages && \
    if [ "$INSTALL_RERANK" = "true" ]; then \
      pip install --no-cache-dir -r requirements-rerank.txt --target /build/packages; \
    fi

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /build/packages /usr/local/lib/python3.12/site-packages
COPY backend/ .
EXPOSE 8000
ENV PYTHONPATH=/app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
